@startuml
title レベル1詳細：練習・模試・CSV処理

left to right direction
skinparam shadowing false
skinparam rectangle {
  RoundCorner 10
}

actor "学習者" as Learner

rectangle "練習問題表示" {
  rectangle "1.1\nPart検証" as P11
  rectangle "1.2\n設問検索" as P12
  rectangle "1.3\n誤答優先並べ替え" as P13
  rectangle "1.4\n本文グループ化" as P14
  rectangle "1.5\n画面生成" as P15
}

rectangle "練習回答登録" {
  rectangle "2.1\n入力検証" as P21
  rectangle "2.2\n設問・正答取得" as P22
  rectangle "2.3\n正誤判定" as P23
  rectangle "2.4\n履歴登録" as P24
  rectangle "2.5\n結果画面遷移" as P25
}

rectangle "模試処理" {
  rectangle "4.1\nセッション確認" as P41
  rectangle "4.2\n問題抽出" as P42
  rectangle "4.3\n本文グループ化" as P43
  rectangle "4.4\n模試画面生成" as P44
  rectangle "5.1\n回答取得" as P51
  rectangle "5.2\n制限時間検証" as P52
  rectangle "5.3\n回答採点" as P53
  rectangle "5.4\n集計" as P54
  rectangle "5.5\n結果登録" as P55
  rectangle "5.6\nセッション削除" as P56
}

rectangle "結果・CSV出力" {
  rectangle "3.1\n練習履歴一覧取得" as P31
  rectangle "3.2\n練習履歴詳細取得" as P32
  rectangle "6.1\n模試一覧取得" as P61
  rectangle "6.2\n模試詳細取得" as P62
  rectangle "7.1\n出力種別検証" as P71
  rectangle "7.2\n練習履歴取得" as P72
  rectangle "7.3\n模試結果取得" as P73
  rectangle "7.4\nCSV生成" as P74
}

database "D1 設問" as D1
database "D2 本文グループ" as D2
database "D3 練習履歴" as D3
database "D4 模試結果" as D4
database "HTTPセッション" as Session

Learner --> P11 : partType
P11 --> P12 : 有効なPart
P12 --> D1 : 設問検索
D1 --> P12 : 設問一覧
P12 --> P13 : 設問一覧
P13 --> D3 : 最新履歴参照
D3 --> P13 : 最新回答履歴
P13 --> P14 : 並べ替え済み設問
P14 --> D2 : groupId検索
D2 --> P14 : 本文・文書
P14 --> P15 : 本文付き設問
P13 --> P15 : Part 5単独設問
P15 --> Learner : 練習問題画面

Learner --> P21 : questionId・partType・answer
P21 --> P22 : 検証済み入力
P22 --> D1 : 設問検索
D1 --> P22 : 設問・正答
P22 --> P23 : 設問・正答
P23 --> P24 : 正誤判定
P24 --> D3 : 回答履歴登録
D3 --> P24 : historyId
P24 --> P25 : historyId
P25 --> Learner : 結果画面へのリダイレクト

Learner --> P31 : 練習結果一覧要求
P31 --> D3 : 直近100件取得
D3 --> P31 : 履歴一覧

Learner --> P32 : historyId
P32 --> D3 : 履歴詳細取得
D3 --> P32 : 対象履歴
P31 --> Learner : 練習履歴一覧
P32 --> Learner : 練習履歴詳細

Learner --> P41 : 模試開始要求
P41 --> P42 : 進行中模試なし
P41 --> Session : 進行中模試あり
Session --> P41 : 保存済み問題・開始時刻
P42 --> D1 : パート別ランダム抽出
D1 --> P42 : 合計100問
P42 --> P43 : 抽出問題
P43 --> D2 : groupId検索
D2 --> P43 : 本文・文書
P43 --> P44 : 問題・本文
P42 --> Session : 問題・開始時刻保存
P44 --> Learner : 模試画面・タイマー

Learner --> P51 : answer_questionId
P51 --> Session : 問題・開始時刻取得
Session --> P51 : 問題セット・開始時刻
P51 --> P52 : 回答一覧・開始時刻
P52 --> P53 : 制限時間内
P52 --> P54 : 75分30秒超過
P53 --> P54 : 正解・不正解・未回答
P54 --> P55 : 集計値
P55 --> D4 : 模試結果登録
D4 --> P55 : mockId
P55 --> P56 : mockId
P56 --> Session : 進行中模試属性削除
P56 --> Learner : 結果画面へリダイレクト

Learner --> P61 : 模試一覧要求
P61 --> D4 : 直近100件取得
D4 --> P61 : 模試一覧
Learner --> P62 : mockId
P62 --> D4 : 模試詳細取得
D4 --> P62 : 模試詳細
P61 --> Learner : 模試一覧
P62 --> Learner : 模試詳細

Learner --> P71 : type=practice または type=mock
P71 --> P72 : practice
P71 --> P73 : mock
P72 --> D3 : 練習履歴全件取得
D3 --> P72 : 練習履歴全件
P73 --> D4 : 模試結果全件取得
D4 --> P73 : 模試結果全件
P72 --> P74 : 練習履歴
P73 --> P74 : 模試結果
P74 --> Learner : UTF-8 BOM付きCSV
@enduml